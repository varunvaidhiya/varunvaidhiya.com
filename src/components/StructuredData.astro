---
export interface Props {
  type: "BlogPosting" | "Person" | "WebSite";
  data: any;
}

const { type, data } = Astro.props;

let structuredData = {};

if (type === "BlogPosting") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    author: {
      "@type": "Person",
      name: data.author || "Varun Vaidhiya",
      url: "https://varunvaidhiya.com/about",
    },
    datePublished: data.pubDatetime.toISOString(),
    dateModified: data.modDatetime?.toISOString() || data.pubDatetime.toISOString(),
    publisher: {
      "@type": "Person",
      name: "Varun Vaidhiya",
      logo: {
        "@type": "ImageObject",
        url: "https://varunvaidhiya.com/varun-avatar.jpg",
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    image: data.ogImage || "https://varunvaidhiya.com/varun-avatar.jpg",
    articleSection: data.tags?.[0] || "Technology",
    keywords: data.tags?.join(", ") || "",
  };
} else if (type === "Person") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Varun Vaidhiya",
    url: "https://varunvaidhiya.com",
    image: "https://varunvaidhiya.com/varun-avatar.jpg",
    jobTitle: "Robot Learning & AI Inference Engineer",
    address: {
      "@type": "PostalAddress",
      addressCountry: "GB",
    },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "University of Warwick",
    },
    sameAs: [
      "https://github.com/varunvaidhiya",
      "https://www.linkedin.com/in/varunvaidhiya",
      "https://x.com/VarunVaidhiya",
      "https://varunvaidhiya.substack.com",
      "https://www.youtube.com/@varun.vaidhiya",
      "https://github.com/ohho-robotics",
      "https://pypi.org/user/varunvaidhiya/",
    ],
    description:
      "Varun Vaidhiya is an engineer building software platforms for robot learning (teleoperation data collection, data pipelines, training and serving infrastructure) and optimising AI models for GPU and edge-GPU inference.",
    knowsAbout: [
      "Robot Learning",
      "Imitation Learning",
      "Reinforcement Learning",
      "Simulation (NVIDIA Isaac Sim)",
      "Teleoperation Data Collection",
      "Machine Learning Infrastructure",
      "Data Pipelines",
      "GPU Inference",
      "Edge AI",
      "TensorRT",
      "ONNX",
      "CUDA",
      "Model Quantisation",
      "Performance Optimisation",
      "ARM Architecture",
      "Robot Operating System (ROS)",
      "Machine Learning",
    ],
  };
} else if (type === "WebSite") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Varun Vaidhiya",
    url: "https://varunvaidhiya.com",
    description: "Personal website and blog of Varun Vaidhiya.",
    author: {
      "@type": "Person",
      name: "Varun Vaidhiya",
    },
    potentialAction: {
      "@type": "SearchAction",
      target: "https://varunvaidhiya.com/search?q={search_term_string}",
      "query-input": "required name=search_term_string",
    },
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
